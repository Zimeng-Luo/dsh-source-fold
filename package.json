{
  "name": "dsh-source-fold",
  "version": "0.2.4",
  "description": "DeepSeek Harness 模型岛：来源与模型分层滑动选择、自适应 Default 思考强度滑块",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "src/*.js",
    "src/*.css",
    "scripts/*.cjs",
    "tests/*.cjs",
    "preview.html"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/client.test.cjs",
    "check": "node scripts/build.cjs --check && node --check index.js && node --check client.js && npm test",
    "prepack": "npm run check"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "model-selection",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zimeng-Luo/dsh-source-fold.git"
  },
  "bugs": {
    "url": "https://github.com/Zimeng-Luo/dsh-source-fold/issues"
  },
  "homepage": "https://github.com/Zimeng-Luo/dsh-source-fold#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
